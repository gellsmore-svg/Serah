# Copy to .env and fill only what you use. Serah starts with none of these set.
# Do not commit .env. Placeholders below are names, not credentials.

# Local database. Defaults to ~/.local/share/serah/serah.sqlite
# SERAH_DATA_DIR=
# SERAH_DB_PATH=

# Taxonomy curator and episode extractor: mock (default) or llm
SERAH_CURATOR=mock
SERAH_EXTRACTOR=mock

# Optional OpenAI-compatible LLM for extraction, taxonomy curation, and the
# measurement baseline. Serah does not call it unless a base URL and model are set.
# SERAH_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SERAH_LLM_MODEL=
# SERAH_LLM_API_KEY=
# SERAH_LLM_API_KEY_ENV=SERAH_LLM_API_KEY

# Jev is TypeSafe's hosted System-1 model.
# POST {JEV_BASE_URL}/v1/systemone with a bearer token.
# The key is read from TYPESAFE_API_KEY, then JEV_API_KEY.
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# TYPESAFE_API_KEY=
# JEV_API_KEY=

# Laya is a local System-1 library (pip install laya). Weights load on first score.
# LAYA_DEVICE=cpu
# LAYA_CHECKPOINT=

# Kai (Decision-1.0-Kai) speaks the System One HTTP API at an endpoint you run.
# KAI_BASE_URL=
# KAI_API_KEY=
# KAI_MODEL=Decision-1.0-Kai-0.6B

# Keziah is the local System-1 queue. When this URL is set, `serah score --engine keziah`
# posts the same measurement questions to Keziah's POST /v1/systemone.
# SERAH_KEZIAH_BASE_URL=http://127.0.0.1:8766
# SERAH_KEZIAH_API_KEY=
# SERAH_KEZIAH_MODEL=mock
# SERAH_KEZIAH_TIMEOUT_S=60

# Decider (Mapika decider family) speaks POST /v1/systemone or decider.infer.Decider.
# Weights are not downloaded by Serah.
# DECIDER_BASE_URL=
# DECIDER_API_KEY=
# DECIDER_MODEL=

# Experimental temporal defaults. Not psychological constants.
SERAH_DECAY=exponential
SERAH_HALF_LIFE_HOURS=72
SERAH_ACTIVATION_GAIN=0.35
SERAH_RESERVOIR_UPDATE=bounded_saturating
SERAH_SCORING_MODE=relevant

# Candidate lifecycle. Distinct UTC days of support.
SERAH_CANDIDATE_DAYS=2
SERAH_ACTIVE_DAYS=3
SERAH_MAX_PROPOSALS_PER_DAY=2
